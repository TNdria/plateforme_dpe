# Variables serveur de l'endpoint `api/donnees` (données 2026+).
# Elles ne doivent JAMAIS être préfixées par VITE_ : elles restent côté serveur.
# En local, copier ces lignes dans `.env.local` (ignoré par git) ; en production,
# les définir dans les Environment Variables du projet Vercel.

# Option 1 (recommandée) : chaîne de connexion complète
DATABASE_URL=postgresql://user:password@host:5432/database

# Option 2 : variables séparées (utilisées si DATABASE_URL est absente)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=false

# Signature des jetons de session pour /api/diagnostic. Doit être identique au
# secret utilisé par le login (TDB_SESSION_SECRET de l'edge function), sinon les
# jetons existants sont refusés (401). Sans cette variable, /api/diagnostic
# répond 503 et le client se replie sur l'ancienne fonction.
# TDB_SESSION_SECRET=
